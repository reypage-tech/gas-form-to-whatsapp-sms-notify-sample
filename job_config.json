  "readme": {
    "title": "Form-to-WhatsApp/SMS Notify Queue (sample)",
    "who_it_is_for": "For support or sales teams who want to see how Google Form responses could turn into a per-agent WhatsApp/SMS follow-up queue before any real messaging API is connected.",
    "effect": "Each fictional form response becomes a queue row with a message draft, an assigned agent, a send status, and a retry count. A send log tracks mock attempts, and the dashboard shows unsent and failed counts across the whole queue. No WhatsApp Cloud API or Twilio SMS call is made anywhere in this sample. Every status value and response code comes from a mock export, not a live service.",
    "tabs": [
      {
        "name": "Dashboard",
        "purpose": "Queue totals, unsent/failed/sent counts, backlog, and a per-agent chart"
      },
      {
        "name": "Send Queue",
        "purpose": "One row per fictional form response, with message draft, status, and retry count"
      },
      {
        "name": "Send Log",
        "purpose": "Mock send attempts with a fictional recipient, a mock endpoint name, and a mock response code"
      },
      {
        "name": "Lists (hidden)",
        "purpose": "Agents, channels, statuses, and inquiry types used for dropdown validation"
      }
    ],
    "how_to_try": "Build the workbook locally, open dist/form_to_whatsapp_sms_notify_queue.xlsx, and edit the light blue cells on Send Queue or Send Log (for example, change a Status to Queued) to see the Dashboard counts and chart update."
  }
}